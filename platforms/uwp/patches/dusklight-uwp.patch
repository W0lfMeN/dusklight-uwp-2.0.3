--- a/cmake/UwpLinkManifest.cmake	1970-01-01 01:00:00.000000000 +0100
+++ b/cmake/UwpLinkManifest.cmake	2026-10-31 19:23:17.455585300 +0100
@@ -0,0 +1,196 @@
+# Writes the full link closure of the UWP game library (stage 1) so that the packaged app in
+# platforms/uwp (stage 2) can link it without a hand-maintained list of libraries.
+#
+#   dusk_uwp_write_link_manifest(<target> <output .cmake file>)
+#
+# The generated file sets:
+#   DUSK_UWP_GAME_LIB      the game library itself (linked with /WHOLEARCHIVE)
+#   DUSK_UWP_LINK_LIBS     every other library to link, in discovery order
+#   DUSK_UWP_LINK_OPTIONS  linker flags found among the link items
+#   DUSK_UWP_RUNTIME_DLLS  DLLs of imported/shared dependencies to deploy with the package
+include_guard(GLOBAL)
+
+# Targets that must not end up in the packaged app.
+set(DUSK_UWP_LINK_EXCLUDE aurora_main CACHE STRING "Targets left out of the UWP link manifest")
+
+# Generator expressions that cannot be evaluated outside of a link step.
+set(_DUSK_UWP_UNSUPPORTED_GENEX "LINK_LANGUAGE|COMPILE_LANGUAGE|LINK_LIBRARY|DEVICE_LINK|HOST_LINK|TARGET_PROPERTY")
+
+# Splitting a property on ';' breaks generator expressions that contain lists; join them back
+# together using ',' (only list-taking expressions such as LINK_GROUP are affected).
+function(_dusk_uwp_join_genex_items in_list out_var)
+    set(result "")
+    set(pending "")
+    set(depth 0)
+    foreach (item IN LISTS in_list)
+        if (pending STREQUAL "")
+            set(pending "${item}")
+        else ()
+            set(pending "${pending},${item}")
+        endif ()
+        string(REGEX MATCHALL "\\$<" opens "${item}")
+        string(REGEX MATCHALL ">" closes "${item}")
+        list(LENGTH opens nOpen)
+        list(LENGTH closes nClose)
+        math(EXPR depth "${depth} + ${nOpen} - ${nClose}")
+        if (depth LESS_EQUAL 0)
+            list(APPEND result "${pending}")
+            set(pending "")
+            set(depth 0)
+        endif ()
+    endforeach ()
+    if (NOT pending STREQUAL "")
+        list(APPEND result "${pending}")
+    endif ()
+    set(${out_var} "${result}" PARENT_SCOPE)
+endfunction()
+
+# Unwraps the generator expressions that CMake itself places in link interfaces.
+function(_dusk_uwp_unwrap item out_var)
+    set(result "")
+    if (item MATCHES "^::@")
+        # Directory scope marker added by target_link_libraries() called from another directory.
+    elseif (item MATCHES "^\\$<LINK_ONLY:(.+)>$")
+        _dusk_uwp_unwrap("${CMAKE_MATCH_1}" result)
+    elseif (item MATCHES "^\\$<BUILD_INTERFACE:(.+)>$" OR item MATCHES "^\\$<BUILD_LOCAL_INTERFACE:(.+)>$")
+        _dusk_uwp_unwrap("${CMAKE_MATCH_1}" result)
+    elseif (item MATCHES "^\\$<INSTALL_INTERFACE:")
+    elseif (item MATCHES "^\\$<LINK_GROUP:[^,>]+,(.+)>$")
+        string(REPLACE "," ";" parts "${CMAKE_MATCH_1}")
+        foreach (part IN LISTS parts)
+            _dusk_uwp_unwrap("${part}" partResult)
+            list(APPEND result ${partResult})
+        endforeach ()
+    elseif (item MATCHES "^\\$<\\$<CONFIG:Debug>:")
+        # Stage 1 is always a release (RelWithDebInfo) configuration.
+    elseif (item MATCHES "^\\$<\\$<NOT:\\$<CONFIG:Debug>>:(.+)>$")
+        _dusk_uwp_unwrap("${CMAKE_MATCH_1}" result)
+    else ()
+        set(result "${item}")
+    endif ()
+    set(${out_var} "${result}" PARENT_SCOPE)
+endfunction()
+
+function(_dusk_uwp_walk tgt)
+    get_target_property(aliased ${tgt} ALIASED_TARGET)
+    if (aliased)
+        set(tgt "${aliased}")
+    endif ()
+
+    get_property(visited GLOBAL PROPERTY _DUSK_UWP_VISITED)
+    if (tgt IN_LIST visited OR tgt IN_LIST DUSK_UWP_LINK_EXCLUDE)
+        return()
+    endif ()
+    set_property(GLOBAL APPEND PROPERTY _DUSK_UWP_VISITED "${tgt}")
+
+    get_target_property(type ${tgt} TYPE)
+    get_target_property(imported ${tgt} IMPORTED)
+
+    # The private dependencies of a shared library are already linked into it.
+    set(props INTERFACE_LINK_LIBRARIES)
+    if (NOT imported AND type MATCHES "^(STATIC_LIBRARY|OBJECT_LIBRARY|INTERFACE_LIBRARY)$")
+        list(APPEND props LINK_LIBRARIES)
+    endif ()
+
+    if (type STREQUAL "STATIC_LIBRARY" OR type STREQUAL "SHARED_LIBRARY")
+        set_property(GLOBAL APPEND PROPERTY _DUSK_UWP_LIBS "$<TARGET_LINKER_FILE:${tgt}>")
+    elseif (type STREQUAL "UNKNOWN_LIBRARY")
+        set_property(GLOBAL APPEND PROPERTY _DUSK_UWP_LIBS "$<TARGET_FILE:${tgt}>")
+    endif ()
+    if (type STREQUAL "SHARED_LIBRARY")
+        set_property(GLOBAL APPEND PROPERTY _DUSK_UWP_DLLS "$<TARGET_FILE:${tgt}>")
+    endif ()
+
+    foreach (prop IN LISTS props)
+        get_target_property(raw ${tgt} ${prop})
+        if (NOT raw)
+            continue()
+        endif ()
+        _dusk_uwp_join_genex_items("${raw}" items)
+        foreach (item IN LISTS items)
+            _dusk_uwp_unwrap("${item}" unwrapped)
+            foreach (dep IN LISTS unwrapped)
+                if (dep STREQUAL "")
+                    continue()
+                elseif (TARGET "${dep}")
+                    _dusk_uwp_walk("${dep}")
+                elseif (dep MATCHES "^[-/]")
+                    set_property(GLOBAL APPEND PROPERTY _DUSK_UWP_OPTIONS "${dep}")
+                elseif (dep MATCHES "\\$<")
+                    if (dep MATCHES "${_DUSK_UWP_UNSUPPORTED_GENEX}")
+                        message(WARNING "dusklight-uwp: ignoring link item of ${tgt}: ${dep}")
+                    else ()
+                        set_property(GLOBAL APPEND PROPERTY _DUSK_UWP_LIBS "${dep}")
+                    endif ()
+                else ()
+                    set_property(GLOBAL APPEND PROPERTY _DUSK_UWP_LIBS "${dep}")
+                endif ()
+            endforeach ()
+        endforeach ()
+    endforeach ()
+endfunction()
+
+function(dusk_uwp_write_link_manifest target output)
+    if (CMAKE_CONFIGURATION_TYPES)
+        message(FATAL_ERROR "dusklight-uwp: stage 1 needs a single-configuration generator "
+                "(use the windows-uwp-lib preset)")
+    endif ()
+
+    set_property(GLOBAL PROPERTY _DUSK_UWP_VISITED "${target}")
+    set_property(GLOBAL PROPERTY _DUSK_UWP_LIBS "")
+    set_property(GLOBAL PROPERTY _DUSK_UWP_DLLS "")
+    set_property(GLOBAL PROPERTY _DUSK_UWP_OPTIONS "")
+
+    foreach (prop LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
+        get_target_property(raw ${target} ${prop})
+        if (NOT raw)
+            continue()
+        endif ()
+        _dusk_uwp_join_genex_items("${raw}" items)
+        foreach (item IN LISTS items)
+            _dusk_uwp_unwrap("${item}" unwrapped)
+            foreach (dep IN LISTS unwrapped)
+                if (TARGET "${dep}")
+                    _dusk_uwp_walk("${dep}")
+                elseif (dep MATCHES "^[-/]")
+                    set_property(GLOBAL APPEND PROPERTY _DUSK_UWP_OPTIONS "${dep}")
+                elseif (NOT dep STREQUAL "" AND NOT dep MATCHES "${_DUSK_UWP_UNSUPPORTED_GENEX}")
+                    set_property(GLOBAL APPEND PROPERTY _DUSK_UWP_LIBS "${dep}")
+                endif ()
+            endforeach ()
+        endforeach ()
+    endforeach ()
+
+    # Aggregate target that builds every library in the manifest: libraries only reached through
+    # link interfaces are not necessarily build dependencies of a static library.
+    get_property(visited GLOBAL PROPERTY _DUSK_UWP_VISITED)
+    add_custom_target(${target}_uwp ALL)
+    foreach (tgt IN LISTS visited)
+        get_target_property(type ${tgt} TYPE)
+        get_target_property(imported ${tgt} IMPORTED)
+        if (NOT imported AND type MATCHES "^(STATIC_LIBRARY|SHARED_LIBRARY|OBJECT_LIBRARY)$")
+            add_dependencies(${target}_uwp ${tgt})
+        endif ()
+    endforeach ()
+
+    get_property(libs GLOBAL PROPERTY _DUSK_UWP_LIBS)
+    get_property(dlls GLOBAL PROPERTY _DUSK_UWP_DLLS)
+    get_property(options GLOBAL PROPERTY _DUSK_UWP_OPTIONS)
+    list(REMOVE_DUPLICATES libs)
+    list(REMOVE_DUPLICATES dlls)
+    list(REMOVE_DUPLICATES options)
+    list(LENGTH libs libCount)
+    message(STATUS "dusklight-uwp: link manifest with ${libCount} libraries -> ${output}")
+
+    file(GENERATE OUTPUT "${output}" CONTENT "\
+# Generated by cmake/UwpLinkManifest.cmake during the stage 1 configure. Do not edit.
+set(DUSK_UWP_CONFIG [=[$<CONFIG>]=])
+set(DUSK_UWP_SOURCE_DIR [=[${CMAKE_SOURCE_DIR}]=])
+set(DUSK_UWP_MSVC_VERSION [=[${MSVC_VERSION}]=])
+set(DUSK_UWP_MSVC_RUNTIME_LIBRARY [=[${CMAKE_MSVC_RUNTIME_LIBRARY}]=])
+set(DUSK_UWP_GAME_LIB [=[$<TARGET_LINKER_FILE:${target}>]=])
+set(DUSK_UWP_LINK_LIBS [=[${libs}]=])
+set(DUSK_UWP_LINK_OPTIONS [=[${options}]=])
+set(DUSK_UWP_RUNTIME_DLLS [=[${dlls}]=])
+")
+endfunction()
