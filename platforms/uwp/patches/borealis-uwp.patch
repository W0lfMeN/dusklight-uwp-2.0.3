diff -ruN bor/cmake/DetectVersion.cmake b/cmake/DetectVersion.cmake
--- a/cmake/DetectVersion.cmake	2026-09-30 08:18:15.000000000 +0200
+++ b/cmake/DetectVersion.cmake	2026-10-31 19:23:36.757633897 +0100
@@ -36,6 +36,7 @@
     endif ()
 
     set(BOREALIS_APP_VERSION_OVERRIDE "" CACHE STRING "Override version string (skips git detection and format validation)")
+    set(BOREALIS_APP_VERSION_FALLBACK "" CACHE STRING "Version tag (e.g. v1.2.3) to use when the source tree is not a Git checkout")
 
     if (BOREALIS_APP_VERSION_OVERRIDE)
         set(BOREALIS_APP_DESCRIBE "${BOREALIS_APP_VERSION_OVERRIDE}")
@@ -48,7 +49,17 @@
         message(STATUS "borealis: application version overridden to ${BOREALIS_APP_DESCRIBE}")
     else ()
         find_package(Git)
+        set(_bv_in_git_tree FALSE)
         if (GIT_FOUND)
+            execute_process(WORKING_DIRECTORY ${_bv_root} COMMAND ${GIT_EXECUTABLE} rev-parse --is-inside-work-tree
+                    RESULT_VARIABLE _bv_git_result
+                    OUTPUT_QUIET
+                    ERROR_QUIET)
+            if (_bv_git_result EQUAL 0)
+                set(_bv_in_git_tree TRUE)
+            endif ()
+        endif ()
+        if (_bv_in_git_tree)
             # Reconfigure when Git HEAD changes.
             execute_process(WORKING_DIRECTORY ${_bv_root} COMMAND ${GIT_EXECUTABLE} rev-parse --git-path HEAD
                     OUTPUT_VARIABLE _bv_git_head_filename
@@ -85,7 +96,10 @@
                     OUTPUT_VARIABLE BOREALIS_APP_DATE
                     OUTPUT_STRIP_TRAILING_WHITESPACE)
         else ()
-            message(STATUS "Unable to find git, commit information will not be available")
+            message(STATUS "Not a Git checkout (or Git not found), commit information will not be available")
+        endif ()
+        if (NOT BOREALIS_APP_DESCRIBE AND BOREALIS_APP_VERSION_FALLBACK)
+            set(BOREALIS_APP_DESCRIBE "${BOREALIS_APP_VERSION_FALLBACK}")
         endif ()
 
         if (BOREALIS_APP_DESCRIBE MATCHES "^v([0-9]+)\\.([0-9]+)\\.([0-9]+)([-+].*)?$")
